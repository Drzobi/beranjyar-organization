# ============================================
# BeranjYar Environment Variables
# ============================================

# سرور
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# دیتابیس (فعلاً SQLite، بعداً PostgreSQL)
DATABASE_URL=./data/beranjyar.db

# امنیت
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# تلگرام
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=berenjyarbot

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# پنل مدیریت
ADMIN_PASSWORD=BeranjYar@2026

# لینک‌های اجتماعی
SOCIAL_TELEGRAM_CHANNEL=
SOCIAL_INSTAGRAM=
SOCIAL_X=
SOCIAL_YOUTUBE=
SOCIAL_WEBSITE=

# APK
APK_DOWNLOAD_URL=